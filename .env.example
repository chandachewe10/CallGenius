# Copy to .env and configure before running the app.
# Restart Expo after changing this file: npx expo start -c

# OpenAI — used for transcription and summaries
EXPO_PUBLIC_OPENAI_API_KEY=sk-your-openai-api-key-here

# Lenco Pay — mobile money collections API (Bearer token)
EXPO_PUBLIC_LENCO_SECRET_KEY=your-lenco-secret-key

# Optional: override Lenco API base URL (default: https://api.lenco.co/access/v2)
# EXPO_PUBLIC_LENCO_API_BASE_URL=https://api.lenco.co/access/v2
